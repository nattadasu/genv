# genv Configuration Example
# Place this file at ~/.genv.env
#
# FEATURES:
# - Variable references: Use $VAR to reference other variables
# - Automatic dependency resolution: Variables are sorted topologically
# - Tilde expansion: ~/path expands to /home/user/path
# - System variable preservation: $HOME, $USER stay as references
# - Array spreading: Array elements expand properly in all shells

# ===== Simple Variables =====
# Define simple string variables
EDITOR = "vim"
VISUAL = "code"
BROWSER = "firefox"
PAGER = "less"

# ===== User Information =====
NAME = "Your Name"
EMAIL = "your.email@example.com"

# ===== Development Environment =====
# Project directories (can use ~/ for home directory)
DEV_HOME = "~/dev"
PROJECTS_DIR = "~/projects"
WORKSPACE = "~/workspace"

# Language-specific settings
# Note: Variables can reference other variables defined in this file
GOPATH = "$HOME/go"
GOBIN = "$GOPATH/bin"          # References GOPATH above
CARGO_HOME = "~/.cargo"
CARGO_BIN = "$CARGO_HOME/bin"  # References CARGO_HOME above
RUSTUP_HOME = "~/.rustup"
NODE_ENV = "development"

# ===== PATH Configuration =====
# Arrays are automatically joined with appropriate delimiter for each shell:
# - Bash/Zsh/Sh: colon-separated strings
# - Fish: space-separated array (PATH only), colon string (others)
# - Nushell: actual arrays with spread operator (...)
# - PowerShell: joined with appropriate delimiter
# - Elvish: colon (Unix) or semicolon (Windows)
#
# Array variables can reference other array variables!
# Elements will automatically spread (not become a single string)

# Custom binary paths (can be referenced by PATH below)
MY_BINS = [
    "~/.local/bin",
    "$HOME/bin"
]

# Language binaries
DEV_BINS = [
    "$CARGO_BIN",              # References variable above
    "$GOBIN",                  # References variable above
    "/opt/homebrew/bin",       # Homebrew (macOS)
    "/usr/local/go/bin"
]

# Main PATH - can reference other arrays
PATH = [
    "$PATH",                   # Keep existing PATH
    "$MY_BINS",               # Array elements spread properly
    "$DEV_BINS",              # Array elements spread properly
    "/usr/local/bin"
]

# ===== Other Path-Like Variables =====
# Library paths
LD_LIBRARY_PATH = [
    "$LD_LIBRARY_PATH",
    "/usr/local/lib",
    "$HOME/.local/lib"
]

# Man pages
MANPATH = [
    "$MANPATH",
    "/usr/local/man",
    "$HOME/.local/share/man"
]

# ===== Application Settings =====
# Git - can reference other variables
GIT_EDITOR = "$EDITOR"

# Less options
LESS = "-R"

# FZF (fuzzy finder)
FZF_DEFAULT_OPTS = "--height 40% --layout=reverse --border"

# Python
PYTHONDONTWRITEBYTECODE = "1"
PYTHONUNBUFFERED = "1"

# ===== Variable Reference Examples =====
# Variables are automatically sorted by dependencies (topological sort)
# You can define them in any order!

# These will be reordered automatically:
LEVEL_3 = "$LEVEL_2/subdir"      # Uses LEVEL_2
LEVEL_1 = "$DEV_HOME/project"    # Uses DEV_HOME
LEVEL_2 = "$LEVEL_1/build"       # Uses LEVEL_1
# Output order: DEV_HOME -> LEVEL_1 -> LEVEL_2 -> LEVEL_3

# ===== Custom Variables =====
# Add your own custom environment variables here
MY_API_KEY = "your-api-key-here"
MY_CONFIG_DIR = "$HOME/.config/myapp"

# System variables ($HOME, $USER, etc.) are preserved as references
# They expand at shell runtime, not at generation time
USER_CACHE = "$HOME/.cache/$USER"

# ===== Color Support =====
CLICOLOR = "1"
COLORTERM = "truecolor"

# ===== XDG Base Directory Specification =====
XDG_CONFIG_HOME = "$HOME/.config"
XDG_DATA_HOME = "$HOME/.local/share"
XDG_CACHE_HOME = "$HOME/.cache"
XDG_STATE_HOME = "$HOME/.local/state"
