# genv Configuration Example
# Place this file at ~/.genv.env

# ===== Simple Variables =====
# Define simple string variables
EDITOR = "/usr/bin/vim"
VISUAL = "/usr/bin/code"
BROWSER = "firefox"
PAGER = "less"

# ===== User Information =====
NAME = "Your Name"
EMAIL = "your.email@example.com"

# ===== Development Environment =====
# Project directories
DEV_HOME = "$HOME/dev"
PROJECTS_DIR = "$HOME/projects"
WORKSPACE = "$HOME/workspace"

# Language-specific settings
GOPATH = "$HOME/go"
CARGO_HOME = "$HOME/.cargo"
RUSTUP_HOME = "$HOME/.rustup"
NODE_ENV = "development"

# ===== PATH Configuration =====
# Arrays are automatically joined with appropriate delimiter for each shell
# Use "$PATH" to reference the existing PATH variable
PATH = [
    "$PATH",                    # Keep existing PATH
    "$HOME/.local/bin",         # User local binaries
    "$HOME/bin",                # User binaries
    "$HOME/.cargo/bin",         # Rust binaries
    "$GOPATH/bin",              # Go binaries
    "/opt/homebrew/bin",        # Homebrew (macOS)
    "/usr/local/bin"            # System local binaries
]

# ===== Library Paths =====
LD_LIBRARY_PATH = [
    "$LD_LIBRARY_PATH",
    "/usr/local/lib",
    "$HOME/.local/lib"
]

# ===== Application Settings =====
# Git
GIT_EDITOR = "$EDITOR"

# Less options
LESS = "-R"

# FZF (fuzzy finder)
FZF_DEFAULT_OPTS = "--height 40% --layout=reverse --border"

# Python
PYTHONDONTWRITEBYTECODE = "1"
PYTHONUNBUFFERED = "1"

# ===== Custom Variables =====
# Add your own custom environment variables here
MY_API_KEY = "your-api-key-here"
MY_CONFIG_DIR = "$HOME/.config/myapp"

# ===== Color Support =====
CLICOLOR = "1"
COLORTERM = "truecolor"

# ===== XDG Base Directory Specification =====
XDG_CONFIG_HOME = "$HOME/.config"
XDG_DATA_HOME = "$HOME/.local/share"
XDG_CACHE_HOME = "$HOME/.cache"
XDG_STATE_HOME = "$HOME/.local/state"
